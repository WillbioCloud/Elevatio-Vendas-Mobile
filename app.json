{
  "expo": {
    "name": "Elevatio Vendas",
    "slug": "elevatio-vendas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "elevatiovendas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elevatiovendas.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1c"
      },
      "package": "com.elevatiovendas.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/sora/Sora_400Regular.ttf",
            "node_modules/@expo-google-fonts/sora/Sora_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/sora/Sora_700Bold.ttf",
            "node_modules/@expo-google-fonts/sora/Sora_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-status-bar",
      "expo-splash-screen"
    ]
  }
}
